# Zkopírujte do .env (není v gitu). Čte ho aplikace (aplikace/) i nástroje (tools/rdb.py).

# --- server (Next.js aplikace) ---
# Lokálně Docker (cd aplikace && npm run db:up), v produkci Neon (nastavuje se na Vercelu, ne sem).
# Heslo rodokmen/rodokmen platí jen pro lokální Docker na vašem počítači.
DATABASE_URL=postgres://rodokmen:rodokmen@localhost:5433/rodokmen
TEST_DATABASE_URL=postgres://rodokmen:rodokmen@localhost:5433/rodokmen_test
# Produkce (Neon) – jen pro kopii dat k sobě (npm run db:z-produkce) a zálohy; jinak nechte prázdné
PROD_DATABASE_URL=

# --- klient (AI, Python skripty) ---
# Kam AI zapisuje: lokálně http://localhost:3000, po nasazení adresa vašeho webu (https://<projekt>.vercel.app)
RODOKMEN_API_URL=http://localhost:3000
# Token vytvoří admin: cd aplikace && npm run token -- <nazev> agent
RODOKMEN_API_TOKEN=
