{
  "name": "rodokmen-aplikace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server scripts/seed.mts",
    "db:reset": "tsx --conditions=react-server scripts/migrate.mts --reset && tsx --conditions=react-server scripts/seed.mts",
    "db:zaloha": "tsx --conditions=react-server scripts/zaloha.mts",
    "token": "tsx --conditions=react-server scripts/token.mts",
    "admin": "tsx --conditions=react-server scripts/admin.mts",
    "vercel-build": "tsx --conditions=react-server scripts/migrate.mts && next build",
    "import": "tsx --conditions=react-server scripts/import.mts",
    "db:z-produkce": "tsx --conditions=react-server scripts/z-produkce.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "marked": "^18.1.3",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
